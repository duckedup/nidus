#!/usr/bin/env sh
# Prefer bun, fall back to node. The checker uses only APIs both runtimes share.
set -e
dir=$(CDPATH= cd -- "$(dirname -- "$0")/../lib" && pwd)
if command -v bun >/dev/null 2>&1; then
  exec bun "$dir/check.mjs" "$@"
elif command -v node >/dev/null 2>&1; then
  exec node "$dir/check.mjs" "$@"
else
  echo "nidus-check needs bun or node on PATH" >&2
  exit 127
fi

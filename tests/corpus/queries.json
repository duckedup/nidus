      "name": "glob-predicate-knn-order",
      "section": "7.1",
      "sql": "SELECT * FROM notes WHERE lang LIKE 'r*' ORDER BY knn([1,0,0,0]) LIMIT 3",
      "dsl": {
        "endpoint": "/search",
        "body": {
          "query": [1, 0, 0, 0],
          "scope": ["notes"],
          "top_k": 3,
          "filter": [{ "Glob": ["lang", "r*"] }]

# Committed ceilings for scripts/ceilings.sh. One KEY=value per bound, so a bump is a
# one-line reviewable diff instead of a YAML edit — but it is still a design change
# (D0005): raise the ceiling in the PR that needs it, with the reason in this comment.

# Lean dependency count: `cargo tree -p nidus --no-default-features --edges normal
# --prefix none`, unique crate names. 117 measured 2026-09-13 (D0015 records 120 under
# `-e no-dev`, which keeps build-dependencies; `--edges normal` drops them, hence the
# three-crate gap — this ceiling uses --edges normal). ~28% headroom over the measured
# count: loose enough that ordinary transitive churn does not trip it, tight enough that
# a bundled-C tree or a new heavyweight dependency does. A bump is a design change (D0005).
LEAN_CRATES_MAX=150

# Stripped `cargo build --release` binary, bytes. Asserted on Linux x86_64 only (CI's
# `ubuntu-latest`); reported, not gated, elsewhere, because binary size is
# platform-dependent and only the Linux x86_64 number has been measured in CI. Land this
# job with the deliberately generous value below, then tighten it in the same PR once the
# first green CI run reports the real Linux number (measured value in the commit
# message). Local macOS arm64 measured 27,156,304 bytes stripped on 2026-09-13, for scale
# only — not the CI number, and not what this ceiling is checked against.
BINARY_BYTES_MAX=52428800

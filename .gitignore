.DS_Store
*.swp
.idea/
.vscode/

# ── Retired tracker (migrated to GitHub Issues) ──────────────────────────────
.dolt/
*.db

# Agent worktrees (created inside the repo by isolated subagent runs)
.claude/worktrees/

# ── /nidus skill artifacts ───────────────────────────────────────────────────

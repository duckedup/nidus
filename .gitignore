# ── Rust / Cargo ─────────────────────────────────────────────────────────────
# Compiled output and build artifacts
/target/

# Cargo.lock IS committed (current Cargo guidance, even for libraries): it pins
# reproducible builds for CI/contributors and makes any new (esp. C-compiling
# `*-sys`) dependency show up as a reviewable diff — the zero-FFI guardrail.

# Backup files from `rustfmt`
**/*.rs.bk

# MSVC debug info
*.pdb

# ── nidus stores ─────────────────────────────────────────────────────────────
# Stray store directories/files created by examples or local experiments
*.nidus

# ── Editors / OS ─────────────────────────────────────────────────────────────
.DS_Store
*.swp
.idea/
.vscode/

# ── Stray database files (the tracker's own live under .beads/) ──────────────
.dolt/
*.db

# Agent worktrees (created inside the repo by isolated subagent runs)
.claude/worktrees/

# ── /nidus skill artifacts ───────────────────────────────────────────────────
# Blueprints are transient planning files, deleted once implemented. Ignored so a
# skipped cleanup can never land one in a commit.
BLUEPRINT-*.md

# ── beads tracker ───────────────────────────────────────────────────────────
# NOT `.beads/` — the config a fresh clone needs to find the shared issue
# database is tracked. `.beads/.gitignore` governs what inside it is runtime.
.beads-credential-key

# bd's embedded-dolt gate lock — written at the repo root, so `.beads/.gitignore`
# does not cover it
*.gate.lock

# coordinator dispatch state (see .claude/skills/nidus SKILL.md, Fleet)
.claude/fleet-plan.json

# wdpkr's local index/state directory, written when nidus is pointed at a wdpkr store
.wdpkr/
